# Open Carrusel — copy to .env.local (npm run setup writes this for you)

# Path to the Claude CLI binary. `npm run setup` detects it automatically.
CLAUDE_CLI_PATH=

# ---------------------------------------------------------------------------
# Slide imagery (optional). Without a key the agent builds typography-only
# carousels and never mentions images.
# Key: https://www.magnific.com/user/api-keys
# ---------------------------------------------------------------------------
MAGNIFIC_API_KEY=

# The app polls Magnific for the finished image, which is what works on
# localhost. These two are only useful when the dev server is reachable from
# the internet (ngrok, cloudflared): they let Magnific push the result instead.
# MAGNIFIC_WEBHOOK_URL=https://<your-tunnel>/api/images/webhook
# MAGNIFIC_WEBHOOK_SECRET=
